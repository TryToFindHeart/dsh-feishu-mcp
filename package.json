{
  "name": "dsh-feishu-mcp",
  "version": "0.3.6",
  "description": "飞书全能力插件：结束卡片强提醒、扫码创建应用、私聊指挥、审批/提问卡片、Typing 反应、权限模式与会话路由。",
  "license": "MIT",
  "meta": {
    "title": "飞书通知与私聊入站（全能力）",
    "description": "webhook 结束强提醒 + 扫码一键创建飞书应用 + 私聊指挥 + 审批/提问卡片 + Typing 反应 + 权限模式 + 会话路由。"
  },
  "icon": "icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:webhook": "node scripts/webhook-smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "feishu",
    "webhook",
    "notification",
    "inbound",
    "bot"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "docs/DETAIL.md",
    "scripts/webhook-smoke.mjs",
    "test/*.test.mjs"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "qrcode": "^1.5.4"
  }
}
