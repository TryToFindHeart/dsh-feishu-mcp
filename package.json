{
  "name": "dsh-feishu-mcp",
  "version": "0.3.14",
  "description": "DeepSeek Harness 飞书通知与指挥插件：群 Webhook 强提醒、扫码创建应用、私聊指挥、审批/提问卡片、会话绑定与静默跟随。",
  "license": "MIT",
  "meta": {
    "title": "飞书通知与私聊指挥",
    "description": "双通道任务通知 + 扫码创建飞书应用 + 私聊指挥 + 审批/提问卡片 + 权限模式 + 会话绑定与静默跟随。"
  },
  "icon": "icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:webhook": "node scripts/webhook-smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "feishu",
    "webhook",
    "notification",
    "inbound",
    "bot"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "docs/DETAIL.md",
    "scripts/webhook-smoke.mjs",
    "test/*.test.mjs"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "qrcode": "^1.5.4"
  }
}
