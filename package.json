{
  "name": "dsh-feishu-mcp",
  "version": "0.2.0",
  "description": "任务结束向飞书推送卡片强提醒，并支持通过飞书自建应用私聊把消息转给 DSH。",
  "license": "MIT",
  "meta": {
    "title": "飞书通知与私聊入站",
    "description": "结束卡片强提醒 + 飞书私聊转发到 DSH，支持 webhook、@all、应用机器人长连接与会话绑定。"
  },
  "icon": "icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:webhook": "node scripts/webhook-smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "feishu",
    "webhook",
    "notification",
    "inbound",
    "bot"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "docs/DETAIL.md",
    "scripts/webhook-smoke.mjs",
    "test/*.test.mjs"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0"
  }
}
